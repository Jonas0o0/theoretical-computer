// ==========================================
// TEST JUMP : LA POMME EN DIAGONALE (OPTIMISÉ)
// ==========================================

// 1. VARIABLES (On supprime Y, il sera égal à X)
let x = 1;
let direction = 1; // 1 = Avance, 0 = Recule

// 2. BOUCLE PRINCIPALE
loop {
    // A. On efface l'ancienne position
    poke(124, 3);

    // B. Mise à jour du Mouvement
    if direction == 1 {
        x = x + 1;
    }
    if direction == 0 {
        x = x - 1;
    }

    // C. Gestion des collisions (Dans les coins)
    if x == 15 {
        direction = 0;
    }
    if x == 0 {
        direction = 1;
    }

    // D. On dessine la nouvelle position
    poke(125, x); // Coordonnée X
    poke(126, x); // Coordonnée Y
    poke(124, 2); // Gâchette : 2 = 🍎
}